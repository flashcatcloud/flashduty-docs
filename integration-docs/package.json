{
  "name": "@flashcatcloud/flashduty-docs",
  "version": "0.0.1",
  "description": "Flashduty integration documentation compatibility bundle",
  "type": "module",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "upload": "npm run build && node scripts/upload.mjs",
    "test:openapi-upload": "node --test scripts/upload-openapi.test.mjs",
    "upload:openapi": "node scripts/upload-openapi.mjs"
  },
  "exports": {
    "./zh": {
      "import": "./dist/esm/zh.js"
    },
    "./en": {
      "import": "./dist/esm/en.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@alicloud/cdn20180510": "^1.0.10",
    "@alicloud/openapi-client": "^0.4.12",
    "ali-oss": "^6.22.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {}
}
